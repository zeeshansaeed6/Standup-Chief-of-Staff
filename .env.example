# Server port for the MCP and health HTTP server
PORT=8787

# Allowed origin for web clients connecting to the MCP server
WEB_ORIGIN=http://localhost:5173

# Data mode: "mock" (offline fixtures, zero credentials) or "live" (GitHub REST + GraphQL)
DATA_MODE=mock

# GitHub Personal Access Token (PAT) with repo scope; required only when DATA_MODE=live
GITHUB_TOKEN=

# Developer's GitHub username to identify assigned PRs, issues, and review requests
GITHUB_USER=

# Comma-separated list of GitHub repositories (owner/repo) to monitor in live mode
GITHUB_REPOS=

# Safety guardrail: if false, nudge and snooze operations are strictly simulated locally
LIVE_WRITES=false

# Bedrock mode: "mock" (built-in intelligent template fallback) or "live" (Amazon Bedrock Converse API)
BEDROCK_MODE=mock

# AWS Region where Amazon Bedrock model access is enabled
AWS_REGION=us-east-1

# AWS Credentials (required only when BEDROCK_MODE=live)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock Model ID or Inference Profile ID
# Default: us.amazon.nova-lite-v1:0 (Amazon Nova Lite via cross-region inference profile)
# Alternatives:
#   - us.amazon.nova-micro-v1:0 (Ultra-low latency / lightweight)
#   - us.amazon.nova-pro-v1:0   (High complexity reasoning)
#   - anthropic.claude-3-haiku-20240307-v1:0 (Claude 3 Haiku fallback option)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Threshold in hours after which an unaddressed review request is considered stale
STALE_REVIEW_HOURS=24
